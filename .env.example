# Firebase (client)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional: used for Firebase Analytics on web
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Backend proxy that holds Twilio credentials (never put Auth Token in the app)
EXPO_PUBLIC_TWILIO_PROXY_URL=https://your-cloud-function.example.com/sendInviteSms

# Optional AI proxy
EXPO_PUBLIC_AI_PROXY_URL=https://your-cloud-function.example.com/ai
